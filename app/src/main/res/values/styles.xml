<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="task_progress_bar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/task_progress_bar</item>
    </style>
    
    <style name="add_task_button">
        <item name="android:buttonStyle">@drawable/add_task_button</item>
    </style>
    
    <style name="text_hat_text">
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textColor">@color/deep_ocean</item>
        <item name="android:textSize">18sp</item>
        <item name="android:shadowColor">@color/shadow_color</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowDx">1</item>
    </style>
    
    <style name="text_hat_price" parent="@style/text_hat_text">
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    
    <style name="DialogCustom" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>