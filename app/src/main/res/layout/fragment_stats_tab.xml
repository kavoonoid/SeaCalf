            android:layout_alignParentBottom="true"
            android:text="@integer/stat_3_value"
            android:textColor="@color/dark_blue_2"
            android:textSize="18sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/stat_4"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginStart="34dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/stat_4_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/stat_icon_description"
            android:src="@drawable/stat_stub" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/stat_4_icon"
            android:text="@string/stat_4_description"
            android:textColor="@color/dark_blue_2"
            android:textSize="18sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/stat_4_icon"
            android:layout_alignParentBottom="true"
            android:text="@integer/stat_4_value"
            android:textColor="@color/dark_blue_2"
            android:textSize="18sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/stat_5"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginStart="34dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stat_5_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
